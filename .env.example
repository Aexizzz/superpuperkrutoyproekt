# База API. В dev по умолчанию /api — Vite проксирует на бэкенд (см. vite.config.ts).
VITE_API_URL=/api

# Прокси для npm run dev: куда Vite перенаправляет /api
VITE_PROXY_TARGET=http://localhost:3000

# Таймаут одного запроса, мс
VITE_API_TIMEOUT_MS=15000

# Публичный ключ платёжного провайдера (карта токенизируется у него)
VITE_PAYMENT_PUBLIC_KEY=
